# Local compose defaults. Production settings should come from a secret store
# (see docs/modernization/secrets.md). Every setting may also be supplied as a
# mounted file via the corresponding <NAME>_FILE variable.
#
# Leave a variable unset (commented out) to use the application default; an
# empty value overrides the default with an empty string.
MONGO_URI=mongodb://mongo:27017
MONGO_DB=vantage
# VANTAGE_OIDC_ISSUER=https://idp.example.com/
VANTAGE_OIDC_AUDIENCE=vantage-net
# VANTAGE_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# VANTAGE_OIDC_AUTHORIZATION_URL=
# VANTAGE_OIDC_TOKEN_URL=
# HS256 development secret only; unset in production (JWKS is used instead).
VANTAGE_AUTH_DEV_SECRET=change-me-dev-only
# VANTAGE_AUTH_LEEWAY_SECONDS=30
# VANTAGE_CORS_ORIGINS=https://ops.example.com,https://noc.example.com
# VANTAGE_RATE_LIMIT_PER_MINUTE=120
# VANTAGE_TRUST_PROXY=1
